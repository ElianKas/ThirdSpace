-- Migrate v1 (spots-only cache) -> v2: add the feed cache tables.
-- Idempotent (IF NOT EXISTS) so a DB already carrying these tables is a safe
-- no-op. The driver runs this migration inside its own transaction.

CREATE TABLE IF NOT EXISTS cachedPosts (
    id TEXT NOT NULL PRIMARY KEY,
    author_name TEXT NOT NULL DEFAULT '',
    spot_name TEXT NOT NULL DEFAULT '',
    category TEXT NOT NULL DEFAULT '',
    neighborhood TEXT NOT NULL DEFAULT '',
    verified INTEGER NOT NULL DEFAULT 0,
    text TEXT NOT NULL DEFAULT '',
    created_at_epoch INTEGER NOT NULL DEFAULT 0,
    score INTEGER NOT NULL DEFAULT 0,
    comment_count INTEGER NOT NULL DEFAULT 0,
    my_vote TEXT NOT NULL DEFAULT 'NONE'
);

CREATE TABLE IF NOT EXISTS cachedComments (
    id TEXT NOT NULL PRIMARY KEY,
    post_id TEXT NOT NULL,
    author_name TEXT NOT NULL DEFAULT '',
    text TEXT NOT NULL DEFAULT '',
    created_at_epoch INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX IF NOT EXISTS cachedComments_post_idx ON cachedComments(post_id);

CREATE TABLE IF NOT EXISTS pendingCommentInserts (
    id TEXT NOT NULL PRIMARY KEY,
    post_id TEXT NOT NULL,
    author_id TEXT NOT NULL DEFAULT '',
    text TEXT NOT NULL DEFAULT '',
    enqueued_at INTEGER NOT NULL
);

CREATE TABLE IF NOT EXISTS pendingPostInserts (
    id TEXT NOT NULL PRIMARY KEY,
    spot_id TEXT NOT NULL,
    author_id TEXT NOT NULL DEFAULT '',
    text TEXT NOT NULL DEFAULT '',
    enqueued_at INTEGER NOT NULL
);

CREATE TABLE IF NOT EXISTS pendingVotes (
    post_id TEXT NOT NULL PRIMARY KEY,
    vote_value INTEGER NOT NULL,
    enqueued_at INTEGER NOT NULL
);
