-- ThirdSpace offline cache database (SQLDelight 2.4.1).
--
-- The offline-first spot cache + an outbound pending-insert queue for spots
-- created while offline/unconfigured.
--
-- STORAGE RULE (see steering/architecture.md): only the PERSISTED Spot fields
-- live here. `checkInCount` and `placeholderColorArgb` are UI-only/derived and
-- are NOT stored — they are re-derived on read (checkInCount = 0; the color
-- comes from the category via SpotCategory), exactly as FeedBridge.addSpot
-- already derives them. Booleans are stored as INTEGER 0/1 (SQLite has no
-- native boolean).

-- ---------------------------------------------------------------------------
-- cachedSpots: the local mirror of the remote `public.spots` table. This is
-- the source of truth the map reads synchronously (getSpots()), kept fresh by
-- a background remote replace-all.
-- ---------------------------------------------------------------------------
CREATE TABLE cachedSpots (
    id TEXT NOT NULL PRIMARY KEY,
    owner_id TEXT NOT NULL DEFAULT '',
    name TEXT NOT NULL,
    category TEXT NOT NULL,
    neighborhood TEXT NOT NULL DEFAULT '',
    lat REAL NOT NULL,
    lng REAL NOT NULL,
    verified INTEGER NOT NULL DEFAULT 0
);

-- ---------------------------------------------------------------------------
-- pendingSpotInserts: the outbound queue of locally-created spots awaiting a
-- successful remote insert. A row stays here until its remote insert succeeds,
-- at which point it is deleted (dequeued). `enqueued_at` (epoch millis) orders
-- the queue so inserts flush oldest-first.
-- ---------------------------------------------------------------------------
CREATE TABLE pendingSpotInserts (
    id TEXT NOT NULL PRIMARY KEY,
    owner_id TEXT NOT NULL DEFAULT '',
    name TEXT NOT NULL,
    category TEXT NOT NULL,
    neighborhood TEXT NOT NULL DEFAULT '',
    lat REAL NOT NULL,
    lng REAL NOT NULL,
    verified INTEGER NOT NULL DEFAULT 0,
    enqueued_at INTEGER NOT NULL
);

-- --- cachedSpots queries ---------------------------------------------------

selectAllCachedSpots:
SELECT id, owner_id, name, category, neighborhood, lat, lng, verified
FROM cachedSpots;

-- Upsert so a remote refresh (or a local write-through) overwrites an existing
-- row by primary key rather than failing on conflict.
upsertCachedSpot:
INSERT OR REPLACE INTO cachedSpots(id, owner_id, name, category, neighborhood, lat, lng, verified)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteAllCachedSpots:
DELETE FROM cachedSpots;

countCachedSpots:
SELECT count(*) FROM cachedSpots;

-- --- pendingSpotInserts queries --------------------------------------------

enqueuePendingInsert:
INSERT OR REPLACE INTO pendingSpotInserts(id, owner_id, name, category, neighborhood, lat, lng, verified, enqueued_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectPendingInserts:
SELECT id, owner_id, name, category, neighborhood, lat, lng, verified, enqueued_at
FROM pendingSpotInserts
ORDER BY enqueued_at ASC;

deletePendingInsert:
DELETE FROM pendingSpotInserts WHERE id = ?;

countPendingInserts:
SELECT count(*) FROM pendingSpotInserts;

-- ===========================================================================
-- Feed cache (posts read-only + comments read/write with an outbound queue),
-- alongside the cachedSpots/pendingSpotInserts tables above. Mirrors the spots
-- offline-first shape: a cache the UI reads
-- synchronously, kept fresh by a background remote replace-all, plus an
-- outbound pending-insert queue for comments created while offline.
--
-- STORAGE RULE (mirrors the spots cache): only flat, persisted columns live
-- here. A post's remote `created_at` timestamptz is stored as epoch MILLIS
-- (created_at_epoch) so ordering + relative-time formatting are done shared-
-- side (RelativeTime) without a datetime dependency crossing the boundary.
-- Booleans are stored as INTEGER 0/1. my_vote is a flat "UP"/"DOWN"/"NONE"
-- string (voting is a placeholder "NONE" from the post_feed view for now).
-- ===========================================================================

-- ---------------------------------------------------------------------------
-- cachedPosts: local mirror of the remote `public.post_feed` view's flat row.
-- The source of truth the feed reads synchronously (getPosts()), kept fresh by
-- a background remote replace-all.
-- ---------------------------------------------------------------------------
CREATE TABLE cachedPosts (
    id TEXT NOT NULL PRIMARY KEY,
    author_name TEXT NOT NULL DEFAULT '',
    spot_name TEXT NOT NULL DEFAULT '',
    category TEXT NOT NULL DEFAULT '',
    neighborhood TEXT NOT NULL DEFAULT '',
    verified INTEGER NOT NULL DEFAULT 0,
    text TEXT NOT NULL DEFAULT '',
    created_at_epoch INTEGER NOT NULL DEFAULT 0,
    score INTEGER NOT NULL DEFAULT 0,
    comment_count INTEGER NOT NULL DEFAULT 0,
    my_vote TEXT NOT NULL DEFAULT 'NONE'
);

-- ---------------------------------------------------------------------------
-- cachedComments: local mirror of a post's `public.post_comments`. Read
-- synchronously per post (getComments(postId)); kept fresh by a per-post
-- background replace. An optimistic local comment is upserted here immediately
-- on create (write-through) before/independent of the remote push.
-- ---------------------------------------------------------------------------
CREATE TABLE cachedComments (
    id TEXT NOT NULL PRIMARY KEY,
    post_id TEXT NOT NULL,
    author_name TEXT NOT NULL DEFAULT '',
    text TEXT NOT NULL DEFAULT '',
    created_at_epoch INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX cachedComments_post_idx ON cachedComments(post_id);

-- ---------------------------------------------------------------------------
-- pendingCommentInserts: outbound queue of locally-created comments awaiting a
-- successful remote insert. A row stays here until its remote insert succeeds,
-- then is deleted (dequeued). `enqueued_at` (epoch millis) orders the queue so
-- inserts flush oldest-first. Mirrors pendingSpotInserts.
-- ---------------------------------------------------------------------------
CREATE TABLE pendingCommentInserts (
    id TEXT NOT NULL PRIMARY KEY,
    post_id TEXT NOT NULL,
    author_id TEXT NOT NULL DEFAULT '',
    text TEXT NOT NULL DEFAULT '',
    enqueued_at INTEGER NOT NULL
);

-- --- cachedPosts queries ---------------------------------------------------

selectAllCachedPosts:
SELECT id, author_name, spot_name, category, neighborhood, verified, text, created_at_epoch, score, comment_count, my_vote
FROM cachedPosts
ORDER BY created_at_epoch DESC;

-- Upsert so a remote replace-all (or a local write) overwrites an existing row
-- by primary key rather than failing on conflict.
upsertCachedPost:
INSERT OR REPLACE INTO cachedPosts(id, author_name, spot_name, category, neighborhood, verified, text, created_at_epoch, score, comment_count, my_vote)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteAllCachedPosts:
DELETE FROM cachedPosts;

countCachedPosts:
SELECT count(*) FROM cachedPosts;

-- --- cachedComments queries ------------------------------------------------

selectCachedComments:
SELECT id, post_id, author_name, text, created_at_epoch
FROM cachedComments
WHERE post_id = ?
ORDER BY created_at_epoch ASC;

upsertCachedComment:
INSERT OR REPLACE INTO cachedComments(id, post_id, author_name, text, created_at_epoch)
VALUES (?, ?, ?, ?, ?);

deleteCommentsForPost:
DELETE FROM cachedComments WHERE post_id = ?;

countCachedComments:
SELECT count(*) FROM cachedComments WHERE post_id = ?;

-- --- pendingCommentInserts queries -----------------------------------------

enqueuePendingComment:
INSERT OR REPLACE INTO pendingCommentInserts(id, post_id, author_id, text, enqueued_at)
VALUES (?, ?, ?, ?, ?);

selectPendingComments:
SELECT id, post_id, author_id, text, enqueued_at
FROM pendingCommentInserts
ORDER BY enqueued_at ASC;

deletePendingComment:
DELETE FROM pendingCommentInserts WHERE id = ?;

countPendingComments:
SELECT count(*) FROM pendingCommentInserts;

-- ===========================================================================
-- Post-creation + voting write-path tables (Phase B2), additive alongside the
-- feed cache above. Mirrors the pendingCommentInserts outbound-queue shape.
-- ===========================================================================

-- ---------------------------------------------------------------------------
-- pendingPostInserts: outbound queue of locally-created posts awaiting a
-- successful remote insert into `public.posts`. A row stays here until its
-- remote insert succeeds, then is deleted (dequeued). `enqueued_at` (epoch
-- millis) orders the queue so inserts flush oldest-first. Mirrors
-- pendingCommentInserts. NOTE: the optimistic cached post uses a LOCAL id; the
-- real DB-generated post id arrives on the next remote replace-all refresh (the
-- local-id optimistic row is naturally dropped by replaceAllPosts), so the
-- queue carries only the fields needed to insert (spot_id/author_id/text) — the
-- id here is the LOCAL id purely as the queue primary key / dequeue handle.
-- ---------------------------------------------------------------------------
CREATE TABLE pendingPostInserts (
    id TEXT NOT NULL PRIMARY KEY,
    spot_id TEXT NOT NULL,
    author_id TEXT NOT NULL DEFAULT '',
    text TEXT NOT NULL DEFAULT '',
    enqueued_at INTEGER NOT NULL
);

-- ---------------------------------------------------------------------------
-- pendingVotes: outbound queue of the user's LATEST vote intent per post. Keyed
-- by post_id (one row per post) so a newer tap REPLACES the queued intent
-- (latest-intent-wins via INSERT OR REPLACE on the post_id PK). `value` is the
-- RESOLVED intent: 1 = upvote, -1 = downvote, 0 = CLEAR (delete the user's
-- post_votes row). This differs from the remote `post_votes` table (which only
-- stores +/-1); the queue additionally carries the "clear" intent so the flush
-- can translate value 0 into a DELETE. `enqueued_at` (epoch millis) orders the
-- flush oldest-first.
-- ---------------------------------------------------------------------------
CREATE TABLE pendingVotes (
    post_id TEXT NOT NULL PRIMARY KEY,
    vote_value INTEGER NOT NULL,
    enqueued_at INTEGER NOT NULL
);

-- --- pendingPostInserts queries --------------------------------------------

enqueuePendingPost:
INSERT OR REPLACE INTO pendingPostInserts(id, spot_id, author_id, text, enqueued_at)
VALUES (?, ?, ?, ?, ?);

selectPendingPosts:
SELECT id, spot_id, author_id, text, enqueued_at
FROM pendingPostInserts
ORDER BY enqueued_at ASC;

deletePendingPost:
DELETE FROM pendingPostInserts WHERE id = ?;

countPendingPosts:
SELECT count(*) FROM pendingPostInserts;

-- --- pendingVotes queries --------------------------------------------------

-- Latest-intent-wins: REPLACE by the post_id PK so two taps on the same post
-- collapse to a single queued row carrying the most recent intent.
upsertPendingVote:
INSERT OR REPLACE INTO pendingVotes(post_id, vote_value, enqueued_at)
VALUES (?, ?, ?);

selectPendingVotes:
SELECT post_id, vote_value, enqueued_at
FROM pendingVotes
ORDER BY enqueued_at ASC;

deletePendingVote:
DELETE FROM pendingVotes WHERE post_id = ?;

countPendingVotes:
SELECT count(*) FROM pendingVotes;
